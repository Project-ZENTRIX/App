{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Pack Manifest",
  "type": "object",
  "required": [
    "manifestVersion",
    "contentPackId",
    "contentPackCode",
    "title",
    "version",
    "revision",
    "indexRef",
    "contentRoots"
  ],
  "properties": {
    "manifestVersion": {
      "type": "string"
    },
    "contentPackId": {
      "type": "string",
      "minLength": 1
    },
    "contentPackCode": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "indexRef": {
      "type": "string",
      "minLength": 1
    },
    "contentRoots": {
      "type": "object",
      "required": [
        "courses",
        "lessons",
        "quizzes"
      ],
      "properties": {
        "courses": {
          "type": "string"
        },
        "lessons": {
          "type": "string"
        },
        "quizzes": {
          "type": "string"
        }
      }
    }
  }
}
