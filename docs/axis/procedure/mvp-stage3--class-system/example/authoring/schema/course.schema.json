{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course File",
  "type": "object",
  "required": [
    "courseId",
    "courseCode",
    "packId",
    "chapterId",
    "title",
    "lessons"
  ],
  "properties": {
    "courseId": {
      "type": "string"
    },
    "courseCode": {
      "type": "string"
    },
    "packId": {
      "type": "string"
    },
    "chapterId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "lessons": {
      "type": "array"
    },
    "resources": {
      "type": "array"
    },
    "checks": {
      "type": "array"
    }
  }
}
