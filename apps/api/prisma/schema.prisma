generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
  deleted
}

enum RoleCode {
  admin
  teacher
  student
  operator
}

enum ContentStatus {
  draft
  published
  archived
}

enum EnrollmentStatus {
  active
  paused
  completed
  cancelled
}

enum ProgressStatus {
  not_started
  in_progress
  submitted
  passed
  failed
  completed
}

enum SubmissionStatus {
  queued
  running
  succeeded
  failed
  timeout
  cancelled
}

enum RunStatus {
  queued
  running
  succeeded
  failed
  timeout
  cancelled
}

enum JudgementStatus {
  pending
  passed
  failed
  error
}

enum OrderStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

enum PaymentStatus {
  initiated
  processing
  succeeded
  failed
  reversed
}

enum SubscriptionStatus {
  active
  suspended
  revoked
  expired
}

enum LicenseStatus {
  active
  suspended
  revoked
  expired
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  status        UserStatus @default(active)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions               Session[]
  accounts               Account[]
  oauthAccounts          OAuthAccount[]
  userProfile            UserProfile?
  userRoles              UserRole[]
  refreshTokens          RefreshToken[]
  devices                Device[]
  enrollments            Enrollment[]
  lessonProgresses       LessonProgress[]
  taskSubmissions        TaskSubmission[]
  progressEvents         ProgressEvent[]
  runs                   Run[]
  orders                 Order[]
  payments               Payment[]
  subscriptions          Subscription[]
  userAchievements       UserAchievement[]
  userLevelProgresses    UserLevelProgress[]
  desktopLicenses        DesktopLicense[]
  deviceBindings         DeviceBinding[]
  auditLogs              AuditLog[]
  notificationPreference NotificationPreference?

  @@map("user")
}

model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipAddress String?
  userAgent String?
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  provider              String    @default("credentials")
  identifier            String
  passwordHash          String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, identifier])
  @@index([userId])
  @@map("account")
}

model OAuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  scope             String?
  tokenType         String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     Boolean  @default(true)
  sms       Boolean  @default(false)
  inApp     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id        String   @id @default(cuid())
  code      RoleCode @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserRole[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  deviceKey String   @unique
  name      String?
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceBindings DeviceBinding[]

  @@index([userId])
}

model Course {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  summary        String?
  cover         String?
  category      String?
  language      String?
  difficulty    String?
  tags          String[]        @default([])
  price         Decimal         @db.Decimal(12, 2) @default(0)
  currency      String          @default("CNY")
  status         ContentStatus   @default(draft)
  version        Int             @default(1)
  versionLabel   String?
  unlockScope    String          @default("none")
  isPurchased    Boolean         @default(false)
  isLearnable    Boolean         @default(false)
  isOffline      Boolean         @default(false)
  supportedLanguages String[]     @default([])
  chapterCount   Int             @default(0)
  lessonCount    Int             @default(0)
  taskCount      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  chapters       Chapter[]
  lessons        Lesson[]
  tasks          Task[]
  enrollments    Enrollment[]
  products       Product[]
  contentAssets  ContentAsset[]
  progressEvents ProgressEvent[]
}

model Chapter {
  id        String        @id @default(cuid())
  courseId  String
  title     String
  summary   String?
  sortOrder Int           @default(0)
  status    ContentStatus @default(draft)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id        String        @id @default(cuid())
  courseId  String
  chapterId String?
  title     String
  summary   String?
  durationMinutes Int     @default(0)
  sortOrder Int           @default(0)
  status    ContentStatus @default(draft)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter        Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  tasks          Task[]
  progress       LessonProgress[]
  contentAssets  ContentAsset[]
  progressEvents ProgressEvent[]

  @@index([courseId])
  @@index([chapterId])
}

model Task {
  id          String        @id @default(cuid())
  courseId    String
  lessonId    String?
  title       String
  description String?
  type        String?
  points      Int           @default(0)
  sortOrder   Int           @default(0)
  status      ContentStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson         Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  testCases      TestCase[]
  submissions    TaskSubmission[]
  runs           Run[]
  progressEvents ProgressEvent[]
  contentAssets  ContentAsset[]

  @@index([courseId])
  @@index([lessonId])
}

model TestCase {
  id        String   @id @default(cuid())
  taskId    String
  input     String
  expected  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ContentAsset {
  id        String   @id @default(cuid())
  courseId  String?
  lessonId  String?
  taskId    String?
  fileName  String
  mimeType  String?
  url       String
  metadata  Json?
  createdAt DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([lessonId])
  @@index([taskId])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(active)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id        String         @id @default(cuid())
  userId    String
  lessonId  String
  status    ProgressStatus @default(not_started)
  progress  Int            @default(0)
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model TaskSubmission {
  id          String           @id @default(cuid())
  userId      String
  taskId      String
  status      SubmissionStatus @default(queued)
  code        String?
  language    String?
  runId       String?          @unique
  submittedAt DateTime         @default(now())
  evaluatedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run  Run? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
  @@index([submittedAt])
}

model ProgressEvent {
  id        String   @id @default(cuid())
  userId    String
  courseId  String?
  lessonId  String?
  taskId    String?
  eventType String
  payload   Json?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([lessonId])
  @@index([taskId])
  @@index([createdAt])
}

model Run {
  id          String    @id @default(cuid())
  userId      String
  taskId      String
  status      RunStatus @default(queued)
  input       String?
  output      String?
  error       String?
  runtimeMs   Int?
  memoryKb    Int?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  deletedAt   DateTime?

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  logs       RunLog[]
  judgement  Judgement?
  sandboxJob SandboxJob?
  submission TaskSubmission?

  @@index([userId])
  @@index([taskId])
  @@index([status])
}

model RunLog {
  id         String    @id @default(cuid())
  runId      String
  level      String
  message    String
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model Judgement {
  id        String          @id @default(cuid())
  runId     String          @unique
  status    JudgementStatus @default(pending)
  score     Int?
  feedback  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model SandboxJob {
  id            String    @id @default(cuid())
  runId         String    @unique
  status        RunStatus @default(queued)
  retryCount    Int       @default(0)
  queueName     String?
  resourceLimit Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Product {
  id          String        @id @default(cuid())
  courseId    String?
  code        String        @unique
  name        String
  description String?
  status      ContentStatus @default(draft)
  price       Decimal       @db.Decimal(12, 2)
  currency    String        @default("CNY")
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  course        Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  orderItems    OrderItem[]
  subscriptions Subscription[]

  @@index([courseId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  orderNo     String      @unique
  status      OrderStatus @default(pending)
  totalAmount Decimal     @db.Decimal(12, 2)
  currency    String      @default("CNY")
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  payments      Payment[]
  subscriptions Subscription[]

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
}

model OrderItem {
  id        String    @id @default(cuid())
  orderId   String
  productId String?
  name      String
  quantity  Int       @default(1)
  unitPrice Decimal   @db.Decimal(12, 2)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id           String        @id @default(cuid())
  userId       String
  orderId      String?
  paymentNo    String        @unique
  status       PaymentStatus @default(initiated)
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("CNY")
  provider     String?
  externalRef  String?
  gatewayTxnId String?       @unique
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  events PaymentEvent[]

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([deletedAt])
}

model PaymentEvent {
  id         String    @id @default(cuid())
  paymentId  String
  eventType  String
  payload    Json?
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([createdAt])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  productId String?
  orderId   String?
  status    SubscriptionStatus @default(active)
  startedAt DateTime           @default(now())
  endsAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([status])
  @@index([deletedAt])
}

model Achievement {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users UserAchievement[]

  @@index([deletedAt])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  achievedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([achievementId])
}

model Level {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  rank      Int       @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users UserLevelProgress[]

  @@index([deletedAt])
}

model UserLevelProgress {
  id        String   @id @default(cuid())
  userId    String
  levelId   String
  progress  Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([levelId])
}

model DesktopLicense {
  id                String        @id @default(cuid())
  userId            String
  licenseKey        String        @unique
  status            LicenseStatus @default(active)
  maxDevices        Int           @default(1)
  maxPrimaryDevices Int           @default(1)
  issuedAt          DateTime      @default(now())
  expiresAt         DateTime?
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices DeviceBinding[]
  events  LicenseEvent[]

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
}

model DeviceBinding {
  id                String    @id @default(cuid())
  userId            String
  desktopLicenseId  String
  deviceId          String
  bindingKey        String    @unique
  deviceFingerprint String?
  deviceSlot        Int       @default(1)
  isPrimary         Boolean   @default(false)
  boundAt           DateTime  @default(now())
  revokedAt         DateTime?
  deletedAt         DateTime?

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  desktopLicense DesktopLicense @relation(fields: [desktopLicenseId], references: [id], onDelete: Cascade)
  device         Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([desktopLicenseId, deviceId])
  @@unique([desktopLicenseId, deviceFingerprint])
  @@unique([desktopLicenseId, deviceSlot])
  @@index([userId])
  @@index([desktopLicenseId])
  @@index([deviceId])
}

model LicenseEvent {
  id               String    @id @default(cuid())
  desktopLicenseId String
  eventType        String
  payload          Json?
  createdAt        DateTime  @default(now())
  archivedAt       DateTime?

  desktopLicense DesktopLicense @relation(fields: [desktopLicenseId], references: [id], onDelete: Cascade)

  @@index([desktopLicenseId])
  @@index([createdAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([deletedAt])
}

model IntegrationClient {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  secretHash String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([deletedAt])
}

model FeatureFlag {
  id        String    @id @default(cuid())
  key       String    @unique
  name      String
  enabled   Boolean   @default(false)
  payload   Json?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}
