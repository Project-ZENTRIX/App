{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ZENTRIX Student Client",
    "version": "0.0.1",
    "identifier": "com.zentrix.student-client",
    "build": {
        "beforeDevCommand": "pnpm web:dev",
        "beforeBuildCommand": "pnpm web:build",
        "devUrl": "http://127.20.0.1:5173",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "ZENTRIX Student Client",
                "width": 1440,
                "height": 960,
                "resizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "publisher": "ZENTRIX Studios",
        "icon": ["icons/icon.ico", "icons/icon.png"]
    }
}

